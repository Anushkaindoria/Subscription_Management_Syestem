# ==========================================
# LoopOS Environment Configuration
# Copy this file to .env before starting
# ==========================================

# Application
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Mode (Set to true to use contract fixtures without Postgres)
MOCK_API="true"

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://loopos:loopos_secret_password@localhost:5432/loopos_dev?schema=public"

# Authentication
JWT_SECRET="loopos_hackathon_super_secret_jwt_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Time-Travel Demo Clock
# Leave empty for real system time, or provide ISO timestamp e.g. "2026-11-01T00:00:00.000Z"
CLOCK_MOCK_DATE=""

# Email Testing (Mailpit)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="billing@loopos.local"
MAILPIT_WEB_URL="http://localhost:8025"
AUTH_SECRET=change-me-to-a-32-plus-char-secret
