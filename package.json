
{
  "name": "loopos",
  "version": "0.1.0",
  "private": true,
  "description": "LoopOS: Modular Monolith Subscription Management System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:api": "tsx scripts/check-api.ts",
    "check": "npm run lint && npm run typecheck && npm run check:routes && npm run check:api && npm run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:catalog": "tsx prisma/seed/seed-catalog.ts",
    "db:seed:subscriptions": "tsx prisma/seed/seed-subscriptions.ts",
    "db:seed:billing": "tsx prisma/seed/seed-billing.ts",
    "db:seed:bulk": "tsx prisma/seed/seed-bulk.ts",
    "billing:run": "tsx scripts/run-billing.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "db:seed:users": "tsx prisma/seed/seed-users.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^14.2.15",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "prettier": "^3.3.3",
    "prisma": "^5.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
