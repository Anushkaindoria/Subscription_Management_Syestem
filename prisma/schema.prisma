// ==============================================================================
// LoopOS - Prisma Schema Definition
// OWNER: Dev A (@devA)
// Rule: Only Dev A may modify this file and create migrations.
// All monetary values are stored as INTEGERS in minor units (cents / paise).
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Authentication & RBAC (Dev B domain)
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  paymentsRecorded Payment[] @relation("RecordedPayments")

  @@index([role])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  address   String?
  taxId     String? // e.g. GSTIN / VAT number
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subscriptions Subscription[]
  payments      Payment[]

  @@index([email])
}

// ------------------------------------------------------------------------------
// Catalog & Pricing (Dev B domain)
// ------------------------------------------------------------------------------

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  ANNUALLY
}

model Product {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants               Variant[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
}

model Variant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String   @unique
  priceExtra Int      @default(0) // Minor units (e.g., 500 = $5.00 extra)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]

  @@index([productId])
}

model Plan {
  id            String          @id @default(cuid())
  name          String
  code          String          @unique
  interval      BillingInterval @default(MONTHLY)
  intervalCount Int             @default(1)
  basePrice     Int // Minor units (e.g. 2900 = $29.00 / month)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
}

model QuotationTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?
  durationMonths Int?     @default(12)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id              String            @id @default(cuid())
  templateId      String
  template        QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  variantId       String?
  variant         Variant?          @relation(fields: [variantId], references: [id])
  planId          String?
  plan            Plan?             @relation(fields: [planId], references: [id])
  quantity        Int               @default(1)
  discountPercent Int?              @default(0)
  sortOrder       Int               @default(0)

  @@index([templateId])
}

// ------------------------------------------------------------------------------
// Subscriptions & Lifecycle State Machine (Dev B domain)
// ------------------------------------------------------------------------------

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

model Subscription {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  renewalInterval BillingInterval    @default(MONTHLY)
  autoRenew       Boolean            @default(true)
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  variantId      String?
  variant        Variant?     @relation(fields: [variantId], references: [id])
  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id])
  quantity       Int          @default(1)
  unitPrice      Int // minor units snapshot at time of confirmation
  discountId     String?
  discount       Discount?    @relation(fields: [discountId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

// ------------------------------------------------------------------------------
// Tax Rules & Discounts (Dev A domain)
// ------------------------------------------------------------------------------

model TaxRule {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  rateBasisPoints     Int // e.g. 1800 = 18.00%
  isGst               Boolean  @default(false)
  cgstRateBasisPoints Int? // e.g. 900 = 9% CGST
  sgstRateBasisPoints Int? // e.g. 900 = 9% SGST
  igstRateBasisPoints Int? // e.g. 1800 = 18% IGST
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  type          DiscountType @default(PERCENTAGE)
  value         Int // Percentage in basis points or fixed minor units
  maxUsageLimit Int? // NULL = unlimited
  usageCount    Int          @default(0)
  minOrderValue Int? // Minor units threshold
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptionLines SubscriptionLine[]

  @@index([code])
}

// ------------------------------------------------------------------------------
// Invoicing & Payments (Dev A & Dev B domains)
// ------------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Int // Minor units (before discount and tax)
  taxAmount      Int // Minor units
  discountAmount Int // Minor units
  totalAmount    Int // Minor units
  paidAmount     Int           @default(0)
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  // Critical architectural constraint: guarantee idempotency for billing runs
  @@unique([subscriptionId, periodStart, periodEnd], name: "unique_subscription_billing_period")
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int      @default(1)
  unitPrice      Int // Minor units
  taxAmount      Int // Minor units
  discountAmount Int // Minor units
  totalAmount    Int // Minor units
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  UPI
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  amount         Int // Minor units
  method         PaymentMethod @default(CREDIT_CARD)
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  recordedById   String?
  recordedBy     User?         @relation("RecordedPayments", fields: [recordedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}
